{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "scheme": "kuruma",
    "version": "1.0.0",
    "web": {},
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "允许 Kuruma 使用摄像头采集事故现场画面。",
          "microphonePermission": "允许 Kuruma 使用麦克风采集事故现场声音。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许 Kuruma 使用当前位置记录事故地点。"
        }
      ],
      "@config-plugins/react-native-webrtc",
      "expo-dev-client",
      "expo-router"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kuruma.mobile"
    },
    "android": {
      "package": "com.kuruma.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    }
  }
}
